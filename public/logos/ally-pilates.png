    <style>
      @keyframes scaling {
        10% {
          scale: 1;
        }
        33% {
          scale: 1.12;
        }
        66% {
          scale: 1.12;
        }
        90% {
          scale: 1;
        }
      }

      @keyframes moving-glare {
        0%,
        40% {
          translate: 0 0;
        }
        60%,
        100% {
          translate: var(--stb-page-preloader-translate) 0;
        }
      }

      .preloader {
        --stb-page-preloader-translate: 318px; /* 242 + 76 */

        position: fixed;
        overflow: hidden;
        inset: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(50% 50% at 50% 50%, rgb(112 33 66) 0%, rgb(71 16 29) 100%),
          rgb(71 16 29);
        direction: ltr;
      }

      .preloader::before {
        content: '';
        position: fixed;
        width: 902px;
        height: 929px;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        background-image: url('/rimg/67220bd3e755ceaa43d0488a/preloader/preloader-rays.png');
        z-index: -1;
      }

      .preloader__container {
        position: relative;
        width: 242px;
        height: 64px;
        animation: scaling 4s ease-in-out infinite;
      }

      .preloader__logo {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
      }

      .preloader__mask {
        position: absolute;
        inset: 0;
        z-index: 2;
        mask-image: url('/rimg/67220bd3e755ceaa43d0488a/preloader/preloader-mask.svg');
        mask-repeat: no-repeat;
        mask-size: cover;
        mask-position: center;
      }

      .preloader__decoration {
        position: absolute;
        inset: 0;
        z-index: 3;
        width: 100%;
        height: 100%;
      }

      .preloader__glare {
        position: absolute;
        width: 76px;
        height: 64px;
        left: -76px;
        top: 0;
        animation: moving-glare 4s linear infinite;
      }

      @media only screen and (min-width: 1280px) {
        .preloader {
          --stb-page-preloader-translate: 478px; /* 364 + 114 */
        }

        .preloader__container {
          width: 364px;
          height: 96px;
        }

        .preloader__glare {
          width: 114px;
          height: 96px;
          left: -114px;
        }
      }
    </style>
    <style id="jackpot-widget-styles">
      :root {
        /* typography */
        --jkp-font-primary: var(--stb-font-primary);
        --jkp-font-helper: var(--stb-font-helper);
        --jkp-title-font-weight: var(--stb-title-font-weight);
        --jkp-title-font-size-sm: var(--stb-title-font-size-sm);
        --jkp-title-font-size-md: var(--stb-title-font-size-md);
        --jkp-title-font-size-lg: var(--stb-title-font-size-lg);
        --jkp-title-line-height-sm: var(--stb-title-line-height-sm);
        --jkp-title-line-height-md: var(--stb-title-line-height-md);
        --jkp-title-line-height-lg: var(--stb-title-line-height-lg);
        /* dialog */
        --jkp-dialog-close-button-top: var(--stb-modal-dialog-close-button-top);
        --jkp-dialog-close-button-right: var(--stb-modal-dialog-close-button-right);
        --jkp-dialog-close-button-width: var(--stb-modal-dialog-close-button-width);
        --jkp-dialog-close-button-height: var(--stb-modal-dialog-close-button-height);
      }

      #terms-widget-container,
      #in-game-widget-container {
        --title__text-color: var(--stb-text-secondary);
        --body__text-color: var(--stb-text-secondary);
        --link__text-color: var(--stb-text-secondary);

        --jkp-padding-12x: 0px;
        --jkp-padding-16x: 0px;

        font-style: normal;
      }

      #jackpot-widget-ingame-mobile-container {
        font-style: normal;

        --stb-button-text-gradient: drop-shadow(1px 1px 0 rgb(var(--stb-white)));
        --stb-button-inner-field-inset: 4px;
        --stb-button-inner-decor-opacity: 0;
        --stb-button-inner-border-radius: 4px;
      }

      #terms-widget-container {
        --jkp-padding-8x: 0px;
      }

      #in-game-widget-container {
        margin-inline: calc(var(--jkp-padding-8x) * -1);
      }
    </style>
